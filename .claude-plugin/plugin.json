{
  "name": "astro-lsp",
  "version": "1.1.0",
  "description": "Astro language server support: hover, go-to-definition, references and diagnostics in .astro files",
  "license": "Apache-2.0",
  "author": { "name": "Nyx000" },
  "repository": "https://github.com/Nyx000/astro-lsp",
  "keywords": ["astro", "lsp", "language-server", "code-intelligence"],
  "userConfig": {
    "tsdk": {
      "type": "string",
      "title": "TypeScript SDK path",
      "description": "Path to TypeScript's lib folder, relative to the project root or absolute",
      "default": "node_modules/typescript/lib"
    }
  },
  "lspServers": {
    "astro": {
      "command": "astro-ls",
      "args": ["--stdio"],
      "extensionToLanguage": { ".astro": "astro" },
      "workspaceFolder": "${CLAUDE_PROJECT_DIR}",
      "initializationOptions": {
        "typescript": { "tsdk": "${user_config.tsdk}" }
      }
    }
  }
}
